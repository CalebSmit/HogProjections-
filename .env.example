# Copy to .env (the launch scripts do this for you). All keys are optional —
# the app falls back to bundled sample data without them.

# USDA AMS MyMarketNews API key (free): https://mymarketnews.ams.usda.gov/mymarketnews-api
USDA_MMN_API_KEY=

# USDA NASS Quick Stats API key (free): https://quickstats.nass.usda.gov/api
NASS_API_KEY=

# true = never touch the network, use data/sample only
OFFLINE=false
